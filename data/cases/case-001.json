{
  "id": "case-001",
  "title": "Cart total only reflects first item price",
  "description": "When two products are added to MiniShop's cart, the total shows only the first item's price instead of the sum of both. For example, adding Keyboard ($10) and Mouse Pad ($20) shows $10.00 instead of $30.00.",
  "status": "VERIFIED",
  "createdAt": "2024-12-01T10:00:00.000Z",
  "updatedAt": "2026-10-08T18:53:20.688Z",
  "reproduction": {
    "preconditions": [
      "MiniShop is running at http://localhost:5174",
      "Cart is empty at start"
    ],
    "steps": [
      "Navigate to http://localhost:5174",
      "Click 'Add to Cart' for Keyboard ($10.00)",
      "Click 'Add to Cart' for Mouse Pad ($20.00)",
      "Observe the cart total displayed on the page"
    ],
    "expected": "Cart total displays $30.00",
    "actual": "Cart total displays $10.00 (only first item price)",
    "testFile": "tests/playwright/cases/case-001-cart-total.spec.ts",
    "lastRun": {
      "runAt": "2026-10-08T18:53:11.803Z",
      "passed": false,
      "outcome": "ASSERTION_FAILED",
      "actual": "Error: BTP_ASSERTION: Cart total should be $30.00 after adding $10 + $20 items\n\nexpect(received).toBe(expected) // Object.is equality\n\nExpected: \"$30.00\"\nReceived: \"$10.00\"\nError: BTP_ASSERTION: After adding Mouse Pad, total should be $30.00\n\nexpect(received).toBe(expected) // Object.is equality\n\nExpected: \"$30.00\"\nReceived: \"$10.00\"",
      "expected": "Cart total displays $30.00",
      "durationMs": 11160,
      "runId": "3af89515-454e-45c8-9b6e-0298c64fbce2",
      "testFingerprint": "0881ec9542058856b644c2ef5425d4c8ae544e33a68f25fea917f02b214d0677",
      "testIds": [
        "case-001-cart-total.spec.ts:cart total should equal sum of all item prices:chromium",
        "case-001-cart-total.spec.ts:cart total should update when items are added incrementally:chromium"
      ],
      "reportHash": "f86b4bd18e698162d5cccf913312bda4bf4d53b04b460b7559dad76174b54e87",
      "evidenceIds": [
        "ev-3af89515-454e-45c8-9b6e-0298c64fbce2-resultJson",
