# Bug-to-Proof — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# ── Ports ─────────────────────────────────────────────────────────────────────
# React dashboard (Vite default)
VITE_API_BASE_URL=http://localhost:3001

# Node.js API
API_PORT=3001

# MiniShop (Vite second instance)
MINISHOP_PORT=5174

# ── Storage paths (relative to workspace root) ────────────────────────────────
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_TIMEOUT=30000

# ── LLM Integration (OpenAI-compatible) ──────────────────────────────────────
# The system works fully without these — LLM features are optional enhancements.
# If LLM_API_KEY is absent or empty, all LLM calls are silently skipped and
# fields fall back to their default values. No feature breaks.

LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Set to "true" to enable LLM calls (requires LLM_API_KEY to be set)
LLM_ENABLED=false
