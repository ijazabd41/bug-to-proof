# Bug-to-Proof — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# ── Ports ─────────────────────────────────────────────────────────────────────
# React dashboard (Vite default)
VITE_API_BASE_URL=http://localhost:3001

# Node.js API
API_PORT=3001

# MiniShop (Vite second instance)
MINISHOP_PORT=5174

# ── Storage paths (relative to workspace root) ────────────────────────────────
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_TIMEOUT=30000

# ── LLM Integration (OpenAI-compatible) ──────────────────────────────────────
# Core configured-test workflows work without a provider. Dynamic candidate
# generation requires an enabled provider and a valid key. Never commit keys.

LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Set to "true" to enable LLM calls (requires LLM_API_KEY to be set)
LLM_ENABLED=false

# RAG: lexical is the key-free development baseline.
# For semantic retrieval choose openai (hosted) or ollama (local).
RAG_EMBEDDING_PROVIDER=lexical
RAG_EMBEDDING_MODEL=
# Hosted example: text-embedding-3-small, https://api.openai.com/v1
# Ollama example: nomic-embed-text, http://localhost:11434
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=

# Generation is separate from embeddings. Use openai for an OpenAI-compatible
# chat endpoint (including the existing configured provider), or ollama.
RAG_GENERATION_PROVIDER=disabled
RAG_GENERATION_MODEL=
RAG_GENERATION_BASE_URL=
RAG_GENERATION_API_KEY=
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
# Threshold is model-dependent; tune using your labelled development set.
# Leave unset for the provider default (0.08 lexical, 0.3 semantic).
# RAG_MIN_SCORE=0.3
RAG_TIMEOUT_MS=20000
