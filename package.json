{
  "name": "bug-to-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a bug report into reproducible, evidence-backed proof.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:dashboard\" \"npm run dev:minishop\"",
    "dev:api": "npx tsx services/api/src/index.ts",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:minishop": "npm run dev --workspace=apps/minishop",
    "test": "npm run test:unit && npm run test:playwright",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:playwright": "npm run test --workspace=tests/playwright",
    "build": "npm run build --workspace=apps/dashboard && npm run build --workspace=apps/minishop",
    "demo": "npm run dev",
    "evidence:before": "tsx scripts/record-demo.ts before",
    "evidence:after": "tsx scripts/record-demo.ts after",
    "agent:demo": "tsx scripts/debug-demo.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "typecheck": "npm run typecheck --workspace=services/api && npm run typecheck --workspace=apps/dashboard && npm run typecheck --workspace=apps/minishop",
    "typecheck:evaluation": "tsc --project tsconfig.evaluation.json --noEmit && tsc --project tests/playwright/tsconfig.json --noEmit",
    "rag:evaluate": "tsx scripts/evaluate-rag.ts",
    "repair:evaluate": "tsx scripts/evaluate-repair.ts",
    "arbitrary:evaluate": "tsx scripts/report-ar7-evaluation.ts",
    "arbitrary:evaluate:live": "tsx scripts/run-arbitrary-heldout-evaluation.ts",
    "arbitrary:evaluate:score": "tsx scripts/score-arbitrary-heldout-evaluation.ts",
    "arbitrary:reference:v2": "tsx scripts/verify-prospective-v2-reference.ts",
    "arbitrary:reference:v3": "tsx scripts/verify-prospective-v3-reference.ts",
    "arbitrary:reference:v4": "tsx scripts/verify-prospective-v4-reference.ts",
    "arbitrary:reference:v5": "tsx scripts/verify-prospective-v5-reference.ts",
    "arbitrary:evaluate:isolated": "tsx scripts/run-isolated-prospective-evaluation.ts",
    "arbitrary:evaluate:review-check": "tsx scripts/review-prospective-v2-candidates.ts",
    "arbitrary:evaluate:policy-audit": "tsx scripts/audit-consumed-candidate-policy.ts",
    "arbitrary:evaluate:reconcile": "tsx scripts/reconcile-arbitrary-heldout-evaluation.ts",
    "arbitrary:verify": "tsx scripts/verify-arbitrary-report-to-proof.ts",
    "demo:check": "tsx scripts/check-dynamic-demo-readiness.ts",
    "artifacts:clean": "tsx scripts/clean-artifacts.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^8.2.2",
    "jsdom": "^30.1.1",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
